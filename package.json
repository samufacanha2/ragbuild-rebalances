{
  "name": "ro-skills",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:download": "node scripts/download-assets.mjs",
    "browiki:update": "node scripts/update-browiki.mjs",
    "browiki:descriptions": "node scripts/update-browiki.mjs --descriptions-only",
    "browiki:update:refresh": "node scripts/update-browiki.mjs --refresh",
    "build:data": "node scripts/build-class-data.mjs && node scripts/build-rebalance-catalog.mjs",
    "notes:update": "node scripts/build-rebalance-catalog.mjs",
    "build:data:fetch": "node scripts/build-class-data.mjs --download-sources && node scripts/build-rebalance-catalog.mjs",
    "build:data:refresh": "node scripts/build-class-data.mjs --download-sources --refresh-sources && node scripts/build-rebalance-catalog.mjs",
    "data:sources": "node scripts/build-class-data.mjs --download-sources-only",
    "data:sources:refresh": "node scripts/build-class-data.mjs --download-sources-only --refresh-sources",
    "rebalances:extract": "node scripts/extract-rebalances.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
